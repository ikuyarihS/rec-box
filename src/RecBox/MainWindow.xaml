<ui:FluentWindow
    x:Class="RecBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:RecBox.ViewModels"
    xmlns:l="clr-namespace:RecBox"
    xmlns:core="clr-namespace:RecBox.Core;assembly=RecBox.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    Title="RecBox"
    Width="480" Height="820" MinWidth="400" MinHeight="440"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Icon="pack://application:,,,/Assets/recbox.ico">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding DismissMessagesCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- The record button: a ring that breathes while recording, a dot that becomes a stop square -->
        <Style x:Key="RecordButton" TargetType="Button">
            <Setter Property="Width" Value="136" />
            <Setter Property="Height" Value="136" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Pulse" Stroke="{StaticResource RecBrush}" StrokeThickness="2" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale" ScaleX="0.86" ScaleY="0.86" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Track" Margin="10" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                     StrokeThickness="1" Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Ellipse x:Name="Focus" Margin="4" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                     StrokeThickness="2" Opacity="0" />
                            <Grid x:Name="Face" Margin="22" RenderTransformOrigin="0.5,0.5">
                                <Ellipse x:Name="Disc" Fill="{StaticResource RecBrush}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#7A1A14" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="Dot" Width="34" Height="34" Fill="White" />
                                <Rectangle x:Name="Square" Width="32" Height="32" RadiusX="6" RadiusY="6" Fill="White" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource RecBrushHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Wait" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Square" Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Breathe">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                                             From="0.86" To="1.0" Duration="0:0:1.6">
                                                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="4" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                                             From="0.86" To="1.0" Duration="0:0:1.6">
                                                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="4" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                             From="0.7" To="0" Duration="0:0:1.6">
                                                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="2" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Breathe" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- thin level meter -->
        <Style x:Key="Meter" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- one row of "this recording": icon, title, what it is set to (and what Auto picked), the control on the right -->
        <Style x:Key="ChoiceRow" TargetType="Grid">
            <Setter Property="Margin" Value="16,12,12,12" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="RecBox" CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/recbox.ico" />
            </ui:TitleBar.Icon>
            <!-- the interface language, one click: English | Tiếng Việt (applies at once, saved) -->
            <ui:TitleBar.TrailingContent>
                <Border x:Name="UiLanguageSwitch" Padding="2" Margin="0,0,8,0" CornerRadius="6" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="{l:T x_ui_switch_tip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="UiEnglishButton" Content="{l:T ui_lang_en}" Padding="8,2" FontSize="12"
                                   Command="{Binding SwitchUiLanguageCommand}" CommandParameter="en"
                                   AutomationProperties.Name="{l:T ui_lang_en}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Primary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVietnamese}" Value="True">
                                            <Setter Property="Appearance" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button x:Name="UiVietnameseButton" Content="{l:T ui_lang_vi}" Padding="8,2" FontSize="12" Margin="2,0,0,0"
                                   Command="{Binding SwitchUiLanguageCommand}" CommandParameter="vi"
                                   AutomationProperties.Name="{l:T ui_lang_vi}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVietnamese}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Border>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- the main page on the left, the live text panel on the right (inside this window: no extra window or taskbar entry) -->
        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainColumn" Width="*" MinWidth="380" />
                <ColumnDefinition x:Name="SplitColumn" Width="Auto" />
                <ColumnDefinition x:Name="LiveColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- ================= RECORD VIEW ================= -->
            <!-- the whole page scrolls, so nothing is cut on a short window (1366x768 at 150%) -->
            <ScrollViewer x:Name="RecordScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding SettingsOpen, Converter={StaticResource InvBoolToVis}}">
            <Grid Margin="24,0,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- status + live text + settings -->
                <Grid Grid.Row="0" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="2,0,8,0" Fill="{StaticResource RecBrush}"
                                 Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- one click opens or closes the live text panel beside this page, also while recording -->
                        <ui:Button x:Name="LiveTextButton" Appearance="Transparent" Padding="8,6" Margin="0,0,4,0"
                                   Icon="{ui:SymbolIcon ClosedCaption24}" Content="{l:T x_live_text}"
                                   ToolTip="{l:T x_live_text_tip}" AutomationProperties.Name="{l:T x_live_text_name}"
                                   Command="{Binding OpenLiveCommand}" />
                        <ui:Button Appearance="Transparent" Padding="8"
                                   Icon="{ui:SymbolIcon Settings24}" ToolTip="{l:T x_settings_tip}"
                                   AutomationProperties.Name="{l:T x_settings}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                                   Command="{Binding ToggleSettingsCommand}" />
                    </StackPanel>
                </Grid>

                <!-- hero: button + timer -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <Button Style="{StaticResource RecordButton}"
                            Command="{Binding ToggleRecordCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                            AutomationProperties.Name="{Binding RecordButtonName}"
                            ToolTip="{Binding RecordButtonName}" />
                    <TextBlock Text="{Binding ElapsedText}" Margin="0,10,0,0" HorizontalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="36" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding HintText}" Margin="0,2,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource Caption}" />
                </StackPanel>

                <!-- messages -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <ui:InfoBar Title="{l:T x_could_not_record}" Message="{Binding Error}" Severity="Error" IsClosable="True"
                                IsOpen="{Binding Error, Converter={StaticResource NullToVis}, Mode=OneWay}"
                                Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
                    <ui:InfoBar Message="{Binding Notice}" Severity="Informational" IsClosable="True" Margin="0,6,0,0"
                                IsOpen="{Binding Notice, Converter={StaticResource NullToVis}, Mode=OneWay}"
                                Visibility="{Binding Notice, Converter={StaticResource NullToVis}}" />
                </StackPanel>

                <!-- transcribing: what it does now, and a way out -->
                <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,10,0,0" Padding="16,12"
                        Visibility="{Binding IsTranscribing, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T x_writing_transcript}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TranscribeProgress}" Style="{StaticResource Caption}" Margin="0,2,0,6"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Height="4" IsIndeterminate="True" />
                            <TextBlock Text="{l:T x_record_meanwhile}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{l:T x_cancel}"
                                   Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelTranscriptCommand}"
                                   ToolTip="{l:T x_cancel_tip}" />
                    </Grid>
                </Border>

                <!-- this recording: every per-recording choice, one click each, with what it is set to -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="{l:T x_this_recording}" Style="{StaticResource SectionHeader}" Margin="2,12,0,8" />
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <!-- mic -->
                            <Grid Style="{StaticResource ChoiceRow}" Margin="16,14,12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Mic24" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:T x_mic}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:T x_mic_sub}" Style="{StaticResource Caption}" Margin="0,1,0,8" />
                                    <ComboBox ItemsSource="{Binding MicDevices}" SelectedItem="{Binding SelectedMicDevice}"
                                              DisplayMemberPath="Name"
                                              IsEnabled="{Binding CanEditSources}" AutomationProperties.Name="{l:T x_mic_device}"
                                              ToolTip="{l:T x_mic_tip}" />
                                    <TextBlock Text="{Binding MicDeviceText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding MicDeviceText, Converter={StaticResource NullToVis}}" />
                                    <Border Style="{StaticResource Meter}" Margin="0,10,0,0">
                                        <Border Background="{DynamicResource SystemAccentColorPrimaryBrush}" CornerRadius="2"
                                                HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding MicLevel, Converter={StaticResource LevelToScale}}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{Binding MicQuietWarning}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding MicQuietWarning, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top"
                                                 IsChecked="{Binding MicEnabled}" IsEnabled="{Binding CanEditSources}"
                                                 AutomationProperties.Name="{l:T x_record_mic}" />
                            </Grid>
                            <Separator Margin="0" Opacity="0.6" />
                            <!-- speaker -->
                            <Grid Style="{StaticResource ChoiceRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Speaker224" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:T x_sys}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:T x_sys_sub}" Style="{StaticResource Caption}" Margin="0,1,0,8" TextWrapping="Wrap" />
                                    <ComboBox ItemsSource="{Binding SpeakerDevices}" SelectedItem="{Binding SelectedSpeakerDevice}"
                                              DisplayMemberPath="Name"
                                              IsEnabled="{Binding CanEditSources}" AutomationProperties.Name="{l:T x_sys_device}"
                                              ToolTip="{l:T x_sys_tip}" />
                                    <TextBlock Text="{Binding SpeakerDeviceText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding SpeakerDeviceText, Converter={StaticResource NullToVis}}" />
                                    <Border Style="{StaticResource Meter}" Margin="0,10,0,0">
                                        <Border Background="{DynamicResource SystemAccentColorPrimaryBrush}" CornerRadius="2"
                                                HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding SpeakerLevel, Converter={StaticResource LevelToScale}}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top"
                                                 IsChecked="{Binding SpeakerEnabled}" IsEnabled="{Binding CanEditSources}"
                                                 AutomationProperties.Name="{l:T x_record_sys}" />
                            </Grid>
                            <Separator Margin="0" Opacity="0.6" />
                            <!-- language: changeable while recording, applies from the next piece of speech -->
                            <Grid Style="{StaticResource ChoiceRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:T x_spoken}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                    <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                              DisplayMemberPath="Name" AutomationProperties.Name="{l:T x_spoken}"
                                              ToolTip="{l:T x_spoken_tip}" />
                                    <TextBlock Text="{Binding LanguagePickedText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Separator Margin="0" Opacity="0.6" />
                            <!-- transcript after Stop -->
                            <Grid Style="{StaticResource ChoiceRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:T x_transcript_after}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EngineText}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PrivacyLine" Text="{Binding PrivacyText}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top"
                                                 IsChecked="{Binding TranscribeEnabled}" AutomationProperties.Name="{l:T x_transcript_after}" />
                            </Grid>
                            <Separator Margin="0" Opacity="0.6" />
                            <!-- live text -->
                            <Grid Style="{StaticResource ChoiceRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ClosedCaption24" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:T x_live_while}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LiveEngineText}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                    <ui:HyperlinkButton Padding="0" Margin="0,2,0,0" Content="{l:T x_live_toggle_panel}"
                                                        Command="{Binding OpenLiveCommand}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top"
                                                 IsChecked="{Binding LiveEnabled}" AutomationProperties.Name="{l:T x_live_while}" />
                            </Grid>
                            <Separator Margin="0" Opacity="0.6" />
                            <!-- live coach: off by default; one click to set up this meeting -->
                            <Grid Style="{StaticResource ChoiceRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Lightbulb24" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:T x_coach}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CoachSummary}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{l:T x_coach_sends}"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding CoachSendsOut, Converter={StaticResource BoolToVis}}" />
                                    <ui:HyperlinkButton x:Name="CoachSetupLink" Padding="0" Margin="0,2,0,0" HorizontalContentAlignment="Left"
                                                        Command="{Binding ToggleCoachSetupCommand}">
                                        <TextBlock Text="{l:T x_coach_setup_link}" TextWrapping="Wrap" />
                                    </ui:HyperlinkButton>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top"
                                                 IsChecked="{Binding CoachEnabled}" AutomationProperties.Name="{l:T x_coach}" />
                            </Grid>
                            <!-- the meeting setup, inline (no extra window); changes apply from the coach's next look -->
                            <Border x:Name="CoachSetupPanel" Margin="16,0,12,12" Padding="14,10" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding CoachSetupOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{l:T x_goal}" Style="{StaticResource Body}" />
                                    <ui:TextBox Margin="0,4,0,0" Text="{Binding CoachGoal, UpdateSourceTrigger=LostFocus}"
                                                PlaceholderText="{l:T x_goal_ph}"
                                                AutomationProperties.Name="{l:T x_goal}" />
                                    <TextBlock Text="{l:T x_role}" Style="{StaticResource Body}" Margin="0,10,0,0" />
                                    <ui:TextBox Margin="0,4,0,0" Text="{Binding CoachRole, UpdateSourceTrigger=LostFocus}"
                                                PlaceholderText="{l:T x_role_ph}"
                                                AutomationProperties.Name="{l:T x_role}" />
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="{l:T x_brief}" Style="{StaticResource Body}" VerticalAlignment="Bottom" Margin="0,0,90,0" TextWrapping="Wrap" />
                                        <ui:HyperlinkButton HorizontalAlignment="Right" Padding="4,0" Content="{l:T x_load_file}"
                                                            Command="{Binding LoadBriefFileCommand}" />
                                    </Grid>
                                    <ui:TextBox Margin="0,4,0,0" Text="{Binding CoachBrief, UpdateSourceTrigger=LostFocus}"
                                                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180"
                                                VerticalScrollBarVisibility="Auto"
                                                PlaceholderText="{l:T x_brief_ph}"
                                                AutomationProperties.Name="{l:T x_brief_name}" />
                                    <TextBlock Text="{l:T x_style}" Style="{StaticResource Body}" Margin="0,10,0,0" />
                                    <ComboBox Margin="0,4,0,0" ItemsSource="{Binding CoachStyleOptions}" SelectedItem="{Binding CoachStyle}"
                                              DisplayMemberPath="Name" AutomationProperties.Name="{l:T x_style_name}" />
                                    <ui:TextBox Margin="0,6,0,0" Text="{Binding CoachInstructions, UpdateSourceTrigger=LostFocus}"
                                                PlaceholderText="{l:T x_instr_ph}"
                                                AutomationProperties.Name="{l:T x_instr_name}" />
                                    <TextBlock Text="{l:T x_coach_writes}" Style="{StaticResource Body}" Margin="0,10,0,0" />
                                    <ComboBox Margin="0,4,0,0" ItemsSource="{Binding CoachLanguageOptions}" SelectedItem="{Binding CoachLanguage}"
                                              DisplayMemberPath="Name" AutomationProperties.Name="{l:T x_coach_lang_name}" />

                                    <Separator Margin="0,12" Opacity="0.6" />
                                    <TextBlock Text="{l:T x_ai}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{l:T x_ai_sub}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    <ComboBox Margin="0,4,0,0" ItemsSource="{Binding CoachProviderOptions}" SelectedItem="{Binding CoachProvider}"
                                              DisplayMemberPath="Name" AutomationProperties.Name="{l:T x_ai_name}" />
                                    <TextBlock Text="{Binding CoachToolStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding CoachToolStatus, Converter={StaticResource NullToVis}}" />
                                    <!-- the model: the tool's own default when empty, or any name typed -->
                                    <StackPanel Visibility="{Binding IsClaudeProvider, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{l:T x_model}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                        <ComboBox Margin="0,2,0,0" IsEditable="True" ItemsSource="{Binding CoachModelOptions}"
                                                  Text="{Binding CoachModelText, UpdateSourceTrigger=LostFocus}"
                                                  AutomationProperties.Name="{l:T x_model_name}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsOtherToolProvider, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{l:T x_model}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                        <ui:TextBox Margin="0,2,0,0" Text="{Binding CoachModelText, UpdateSourceTrigger=LostFocus}"
                                                    PlaceholderText="{l:T x_model_default_ph}" AutomationProperties.Name="{l:T x_model_name}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CoachModelHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding IsEndpointProvider, Converter={StaticResource InvBoolToVis}}" />
                                    <StackPanel Visibility="{Binding IsEndpointProvider, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{l:T x_address}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                        <ui:TextBox Margin="0,2,0,0" Text="{Binding CoachEndpoint, UpdateSourceTrigger=LostFocus}"
                                                    PlaceholderText="http://localhost:11434/v1" AutomationProperties.Name="{l:T x_address_name}" />
                                        <TextBlock Text="{l:T x_model_name_label}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                        <ui:TextBox Margin="0,2,0,0" Text="{Binding CoachEndpointModel, UpdateSourceTrigger=LostFocus}"
                                                    PlaceholderText="llama3.1" AutomationProperties.Name="{l:T x_endpoint_model_name}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TokenEstimateText}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding TokenEstimateText, Converter={StaticResource NullToVis}}" />
                                    <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                    <Separator Margin="0,12" Opacity="0.6" />
                                    <Grid>
                                        <StackPanel Margin="0,0,64,0">
                                            <TextBlock Text="{l:T x_slides}" Style="{StaticResource Body}" />
                                            <TextBlock Text="{l:T x_slides_sub}"
                                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding CaptureSlides}"
                                                         AutomationProperties.Name="{l:T x_slides}" />
                                    </Grid>
                                    <ui:TextBox Margin="0,6,0,0" Text="{Binding SlideWindow, UpdateSourceTrigger=LostFocus}"
                                                PlaceholderText="{l:T x_slides_ph}"
                                                AutomationProperties.Name="{l:T x_slides_name}"
                                                Visibility="{Binding CaptureSlides, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                            <Separator Margin="0" Opacity="0.6" />
                            <!-- translate to: Off, English (offline) or another language through the AI tool picked -->
                            <Grid x:Name="TranslateRow" Style="{StaticResource ChoiceRow}" Margin="16,12,12,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Translate24" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{l:T x_translate}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:T x_translate_sub}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                    <ComboBox Margin="0,8,0,0" ItemsSource="{Binding TranslateOptions}" SelectedItem="{Binding SelectedTranslate}"
                                              DisplayMemberPath="Name" AutomationProperties.Name="{l:T x_translate}"
                                              ToolTip="{l:T x_translate_tip}" />
                                    <TextBlock Text="{Binding TranslateStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding TranslateStatus, Converter={StaticResource NullToVis}}" />
                                    <TextBlock Text="{Binding TranslateUsage}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding TranslateUsage, Converter={StaticResource NullToVis}}" />
                                    <!-- no AI tool ready: pick one right here -->
                                    <StackPanel Margin="0,6,0,0" Visibility="{Binding TranslateNeedsSetup, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{l:T x_translate_pick_ai}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding CoachProviderOptions}" SelectedItem="{Binding CoachProvider}"
                                                  DisplayMemberPath="Name" AutomationProperties.Name="{l:T x_ai_name}" />
                                        <TextBlock Text="{Binding CoachToolStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <ui:HyperlinkButton Padding="0" Margin="0,2,0,0" Content="{l:T x_more_ai}"
                                                            Command="{Binding ToggleCoachSetupCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Margin="16,0,16,12" Height="4" Maximum="100" Value="{Binding DownloadProgress}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- last + recent -->
                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="16,12"
                            Visibility="{Binding LastSessionDir, Converter={StaticResource NullToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastSessionTitle}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastSessionDetail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding TranscriptText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding TranscriptText, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <ui:Button Content="{l:T x_open}" Icon="{ui:SymbolIcon FolderOpen24}" Appearance="Primary"
                                           Command="{Binding OpenFolderCommand}" CommandParameter="{Binding LastSessionDir}"
                                           ToolTip="{l:T x_open_tip}" />
                                <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon Copy24}" Appearance="Secondary"
                                           Command="{Binding CopyPathCommand}" CommandParameter="{Binding LastSessionDir}"
                                           ToolTip="{l:T x_copy_path}" AutomationProperties.Name="{l:T x_copy_path}" />
                                <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon ArrowRepeatAll24}" Appearance="Secondary"
                                           Command="{Binding TranscribeAgainCommand}" CommandParameter="{Binding LastSessionDir}"
                                           IsEnabled="{Binding IsTranscribing, Converter={StaticResource InvBool}}"
                                           ToolTip="{l:T x_again_tip}"
                                           AutomationProperties.Name="{l:T x_again_name}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="2,18,0,6">
                        <TextBlock Text="{l:T x_recent}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:HyperlinkButton x:Name="AllRecordingsLink" HorizontalAlignment="Right" Padding="4,0" Content="{l:T x_all_recordings}"
                                            Command="{Binding OpenOutputFolderCommand}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock Text="{l:T x_recent_empty}"
                                   Style="{StaticResource Caption}" Margin="2,0,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Recent.Count, Converter={StaticResource ZeroToVis}}" />
                        <ItemsControl x:Name="RecentList" ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Directory}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="12,8" Margin="0,0,0,2"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip="{Binding Directory}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <ui:SymbolIcon Grid.Column="1" Symbol="FolderOpen20" FontSize="16" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Grid>
            </ScrollViewer>

            <!-- ================= SETTINGS VIEW: only the rare things ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="24,0,24,24">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:Button Appearance="Transparent" Padding="8" Icon="{ui:SymbolIcon ArrowLeft24}"
                                   ToolTip="{l:T x_back}" AutomationProperties.Name="{l:T x_back}" Command="{Binding ToggleSettingsCommand}" />
                        <TextBlock Text="{l:T x_settings}" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{l:T x_settings_note}"
                               Style="{StaticResource Caption}" Margin="2,6,0,0" TextWrapping="Wrap" />

                    <!-- interface language and the Translate to each recording starts with -->
                    <TextBlock Text="{l:T x_interface}" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Panel}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{l:T x_ui_language}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:T x_ui_language_sub}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding UiLanguageOptions}" SelectedItem="{Binding SelectedUiLanguage}"
                                      DisplayMemberPath="Name" AutomationProperties.Name="{l:T x_ui_language}" />
                            <Separator Margin="0,14" Opacity="0.6" />
                            <TextBlock Text="{l:T x_default_translate}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:T x_default_translate_sub}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding TranslateOptions}" SelectedItem="{Binding DefaultTranslate}"
                                      DisplayMemberPath="Name" AutomationProperties.Name="{l:T x_default_translate}" />
                        </StackPanel>
                    </Border>

                    <!-- files -->
                    <TextBlock Text="{l:T x_files}" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Panel}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{l:T x_save_to}" Style="{StaticResource Body}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding OutputFolder, Mode=OneWay}" IsReadOnly="True" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:T x_change}" Command="{Binding BrowseFolderCommand}" />
                            </Grid>
                            <Separator Margin="0,14" Opacity="0.6" />
                            <Grid>
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="{l:T x_speech_copies}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{l:T x_speech_copies_sub}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding SaveSpeechCopy}"
                                                 AutomationProperties.Name="{l:T x_speech_copies}" />
                            </Grid>
                            <Separator Margin="0,14" Opacity="0.6" />
                            <Grid>
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="{l:T x_mixed}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{l:T x_mixed_sub}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding SaveMixed}"
                                                 AutomationProperties.Name="{l:T x_mixed}" />
                            </Grid>
                            <Separator Margin="0,14" Opacity="0.6" />
                            <Grid>
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="{l:T x_clean}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{l:T x_clean_sub}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding CleanSpeechCopies}"
                                                 AutomationProperties.Name="{l:T x_clean}" />
                            </Grid>
                            <Separator Margin="0,14" Opacity="0.6" />
                            <Grid>
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="{l:T x_boost}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{l:T x_boost_sub}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding BoostMic}"
                                                 AutomationProperties.Name="{l:T x_boost}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- speech models -->
                    <TextBlock Text="{l:T x_models}" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Panel}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{l:T x_model_transcript}" Style="{StaticResource Body}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                                      AutomationProperties.Name="{l:T x_speech_model}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource ModelText}" ConverterParameter="label">
                                                        <Binding />
                                                        <Binding Source="{x:Static core:Loc.Instance}" Path="Language" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Opacity="0.75">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource ModelText}" ConverterParameter="info">
                                                        <Binding />
                                                        <Binding Source="{x:Static core:Loc.Instance}" Path="Language" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:T x_download}" Appearance="Primary"
                                           Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadModelCommand}"
                                           Visibility="{Binding ModelMissing, Converter={StaticResource BoolToVis}}"
                                           IsEnabled="{Binding IsDownloading, Converter={StaticResource InvBool}}" />
                            </Grid>
                            <ProgressBar Margin="0,10,0,0" Height="4" Maximum="100" Value="{Binding DownloadProgress}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding AutoModelText}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding AutoModelText, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{l:T x_live_best}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Separator Margin="0,14" Opacity="0.6" />
                            <Grid>
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="{l:T x_gpu}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{l:T x_gpu_sub}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding UseGpu}"
                                                 AutomationProperties.Name="{l:T x_gpu}" />
                            </Grid>
                            <TextBlock Text="{Binding GpuNote}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding GpuNote, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- updates -->
                    <TextBlock Text="{l:T x_updates}" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Panel}" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="{l:T x_check_start}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding CheckUpdatesOnStart}"
                                                 AutomationProperties.Name="{l:T x_check_start}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <ui:Button Content="{l:T x_check_now}" Command="{Binding CheckUpdatesCommand}" />
                                    <ui:Button Margin="8,0,0,0" Content="{l:T x_restart_update}" Appearance="Primary"
                                               Command="{Binding RestartToUpdateCommand}"
                                               Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                            <ui:HyperlinkButton Margin="0,8,0,0" Padding="0" Content="{l:T x_release_page}"
                                                Command="{Binding OpenReleasePageCommand}"
                                                Visibility="{Binding UpdateLink, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- help -->
                    <TextBlock Text="{l:T x_help}" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Panel}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{l:T x_wrong}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:T x_diag_sub}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button Content="{l:T x_open_logs}" Icon="{ui:SymbolIcon FolderOpen24}"
                                           Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="{l:T x_copy_diag}" Icon="{ui:SymbolIcon Copy24}"
                                           Command="{Binding CopyDiagnosticsCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding DiagnosticsStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding DiagnosticsStatus, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- drag to resize the live text panel -->
            <GridSplitter x:Name="LiveSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Focusable="False" Visibility="Collapsed" ToolTip="{l:T x_drag_resize}" />

            <!-- ================= LIVE TEXT PANEL ================= -->
            <Border x:Name="LivePanel" Grid.Column="2" Margin="0,0,16,16" Style="{StaticResource Panel}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="16,12,10,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- two tabs: what is said, and what the coach makes of it -->
                                <ui:Button x:Name="LiveTabButton" Content="{l:T x_live_text}" Padding="10,4" FontWeight="SemiBold"
                                           Command="{Binding ShowLiveTextCommand}" AutomationProperties.Name="{l:T x_show_live}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowCoachTab}" Value="False">
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button x:Name="CoachTabButton" Content="{l:T x_coach_tab}" Padding="10,4" Margin="4,0,0,0" FontWeight="SemiBold"
                                           Command="{Binding ShowCoachCommand}" AutomationProperties.Name="{l:T x_show_coach}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowCoachTab}" Value="True">
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource RecBrush}"
                                                 Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock x:Name="LagText" Text="{Binding LiveLag}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon Copy24}"
                                           ToolTip="{l:T x_copy_live}" AutomationProperties.Name="{l:T x_copy_live}"
                                           Command="{Binding CopyLiveCommand}" />
                                <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon PanelRightContract24}"
                                           ToolTip="{l:T x_hide_live_tip}" AutomationProperties.Name="{l:T x_hide_live}"
                                           Command="{Binding OpenLiveCommand}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="Name" AutomationProperties.Name="{l:T x_live_lang_name}"
                                      ToolTip="{l:T x_applies_next}" />
                            <ui:ToggleSwitch Grid.Column="1" Margin="10,0,0,0" IsChecked="{Binding LiveEnabled}" Content="{l:T x_on}"
                                             ToolTip="{l:T x_live_onoff}" AutomationProperties.Name="{l:T x_live_while}" />
                        </Grid>
                        <TextBlock Text="{Binding LanguagePickedText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ShowCoachTab, Converter={StaticResource InvBoolToVis}}" />
                        <TextBlock Text="{Binding TranslateStatus}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding TranslateUsesAi, Converter={StaticResource BoolToVis}}" />
                        <!-- the coach's state, usage and where the text goes -->
                        <StackPanel Visibility="{Binding ShowCoachTab, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{Binding CoachSummary}" Style="{StaticResource Caption}" Margin="0,0,64,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding CoachEnabled}" Content="{l:T x_on}"
                                                 ToolTip="{l:T x_coach_onoff}" AutomationProperties.Name="{l:T x_coach}" />
                            </Grid>
                            <TextBlock Text="{Binding CoachStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CoachUsage}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding CoachUsage, Converter={StaticResource NullToVis}}" />
                            <ui:HyperlinkButton Padding="0" Margin="0,2,0,0" Content="{l:T x_setup_meeting}"
                                                Command="{Binding ToggleCoachSetupCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- coach tab: the latest cue, the brief's questions with answers, next steps, notes -->
                    <ScrollViewer x:Name="CoachScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,4,12,10" Focusable="False"
                                  Visibility="{Binding ShowCoachTab, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Border Padding="12,8" CornerRadius="6" Margin="0,0,0,10"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="2,0,0,0"
                                    Visibility="{Binding LatestCue, Converter={StaticResource NullToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{l:T x_say_now}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LatestCue}" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{l:T x_coach_empty}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding CoachNotes.Count, Converter={StaticResource ZeroToVis}}" />

                            <TextBlock Text="{l:T x_questions}" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding CoachQuestions.Count, Converter={StaticResource CountToVis}}" />
                            <ItemsControl ItemsSource="{Binding CoachQuestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Question}" FontSize="14" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Answer}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="12,2,0,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       Visibility="{Binding Answer, Converter={StaticResource NullToVis}}" />
                                            <TextBlock Text="{l:T x_not_answered}" Style="{StaticResource Caption}" Margin="12,2,0,0"
                                                       Visibility="{Binding Answer.Length, Converter={StaticResource ZeroToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{l:T x_next_steps}" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding CoachNextSteps.Count, Converter={StaticResource CountToVis}}" />
                            <ItemsControl ItemsSource="{Binding CoachNextSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Action}" TextWrapping="Wrap" FontSize="14"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="12,2,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{l:T x_attention}" FontWeight="SemiBold" Margin="0,8,0,4"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding CoachAlerts.Count, Converter={StaticResource CountToVis}}" />
                            <ItemsControl ItemsSource="{Binding CoachAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{l:T x_earlier}" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding CoachCues.Count, Converter={StaticResource CountToVis}}" />
                            <ItemsControl ItemsSource="{Binding CoachCues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{l:T x_notes}" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding CoachNotes.Count, Converter={StaticResource CountToVis}}" />
                            <ItemsControl ItemsSource="{Binding CoachNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Visibility="{Binding ShowCoachTab, Converter={StaticResource InvBoolToVis}}">
                        <ScrollViewer x:Name="LiveScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,4,12,10" Focusable="False">
                            <ItemsControl ItemsSource="{Binding LiveLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="14" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                    <Setter Property="Opacity" Value="0.7" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold">
                                                        <Run.Style>
                                                            <Style TargetType="Run">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsYou}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Run.Style>
                                                    </Run><Run Text="{Binding Text, Mode=OneWay}" />
                                                </TextBlock>
                                                <!-- the translation under the original line (Translate to another language) -->
                                                <TextBlock Text="{Binding Translation}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding Translation, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{l:T x_live_empty}"
                                   Style="{StaticResource Caption}" Margin="16,6" TextWrapping="Wrap"
                                   Visibility="{Binding LiveLines.Count, Converter={StaticResource ZeroToVis}}" />
                        <ui:Button x:Name="JumpButton" Content="{l:T x_jump}" Icon="{ui:SymbolIcon ArrowDown24}" Appearance="Primary"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Visibility="Collapsed"
                                   AutomationProperties.Name="{l:T x_jump_name}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- update ready banner, visible from the record view too -->
            <ui:InfoBar Grid.Column="0" VerticalAlignment="Bottom" Margin="24,0,24,16" Severity="Success" IsClosable="True"
                        Title="{l:T x_update_ready}" Message="{l:T x_update_restart}"
                        IsOpen="{Binding UpdateReady, Mode=OneWay}"
                        Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
